@page "/ask-gemini"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UsageTrackingService UsageTrackingService
@inject GeminiService Gemini
@inject AskLimiter Limiter

<PageTitle>Ask Gemini – OxyGenAI</PageTitle>

<div class="ox-page">
    <div>
        <h1>Ask Gemini</h1>
        <p class="ox-lede">
            Every reply shows its token count and estimated impact, and is added to your history.
            To send one prompt to several models, use <a href="compare">Compare models</a>.
        </p>
    </div>

    @if (!Gemini.IsConfigured)
    {
        <div class="alert alert-warning mb-0" role="alert">@GeminiService.MissingKeyMessage</div>
    }

    <div class="ox-split">
        <div class="ox-main">
            <section class="ox-panel d-flex flex-column gap-4" aria-label="Conversation">
                @if (lastPrompt is null)
                {
                    <div class="ox-empty">
                        <Icon Name="spark" Size="26" Color="#0E6B4F" />
                        <p class="mt-2 mb-0">Ask anything. You'll see what each reply cost in water, CO₂ and energy.</p>
                    </div>
                }
                else
                {
                    <div class="ox-bubble-user">@lastPrompt</div>

                    @if (sending)
                    {
                        <p class="ox-note mb-0" role="status">Waiting for Gemini…</p>
                    }
                    else if (reply is not null)
                    {
                        <div class="ox-reply">
                            <span class="ox-rec-icon" style="background: var(--ox-accent-soft)"><Icon Name="spark" Size="18" Color="#0E6B4F" /></span>
                            <div class="ox-reply-body">
                                <div class="ox-note"><strong class="text-body">Gemini</strong> · @reply.Model</div>
                                <p class="ox-reply-text">@reply.Text</p>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="ox-tag">@reply.TotalTokens.ToString("#,0") tokens</span>
                                    @if (saved is not null)
                                    {
                                        <span class="ox-tag ox-tag-water">@saved.TotalWater.ToString("0.###") mL water</span>
                                        <span class="ox-tag">@saved.TotalCo2.ToString("0.###") g CO₂</span>
                                        <span class="ox-tag ox-tag-energy">@saved.TotalEnergy.ToString("0.###") Wh</span>
                                    }
                                    @if (saveMessage == SavedText)
                                    {
                                        <span class="ox-tag ox-tag-ok"><Icon Name="check" Size="14" Stroke="2.5" /> Saved to history</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(saveMessage) && saveMessage != SavedText)
                                {
                                    <p class="ox-status ox-status-error" role="status">@saveMessage</p>
                                }
                            </div>
                        </div>
                    }
                }

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger mb-0" role="alert">@error</div>
                }

                <form class="d-flex flex-column gap-3 pt-3 border-top" @onsubmit="SendAsync" @onsubmit:preventDefault>
                    <div class="d-flex flex-wrap align-items-end gap-3">
                        <div>
                            <label class="form-label" for="model">Model</label>
                            <select id="model" class="form-select" @bind="selectedModel" disabled="@sending">
                                @foreach (var model in Gemini.AvailableModels)
                                {
                                    <option value="@model">@model</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="prompt">Your prompt</label>
                        <textarea id="prompt" class="form-control" rows="4" placeholder="Ask anything…"
                                  maxlength="@Gemini.MaxPromptCharacters"
                                  @bind="prompt" @bind:event="oninput" disabled="@sending"></textarea>
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span class="ox-note">Shorter prompts use fewer tokens · @prompt.Length.ToString("#,0") / @Gemini.MaxPromptCharacters.ToString("#,0") characters</span>
                        <button class="btn btn-primary btn-lg" type="submit"
                                disabled="@(sending || string.IsNullOrWhiteSpace(prompt) || !Gemini.IsConfigured)">
                            @(sending ? "Waiting for Gemini…" : "Send to Gemini") <Icon Name="arrow" Size="18" Stroke="2.2" />
                        </button>
                    </div>
                </form>
            </section>

            <RecommendationList Items="recommendations" />
        </div>

        <aside class="ox-side d-flex flex-column gap-3" aria-label="Impact of this reply">
            <section class="ox-dark-panel">
                <h2>This reply</h2>
                @if (reply is null)
                {
                    <p class="ox-note mb-0">Send a prompt to see how many tokens it used and its estimated water, CO₂ and energy.</p>
                }
                else
                {
                    <div>
                        <div class="d-flex justify-content-between ox-note mb-2"><span>Tokens</span><span class="text-white fw-semibold">@reply.TotalTokens.ToString("#,0") total</span></div>
                        <div class="ox-split-bar" role="img" aria-label="@($"Token split: {reply.PromptTokens} prompt, {reply.CandidateTokens} response, {ThinkingTokens} thinking")">
                            <div style="width: @Share(reply.PromptTokens)%; background: #FFFFFF"></div>
                            <div style="width: @Share(reply.CandidateTokens)%; background: #8FD3B6"></div>
                            <div style="width: @Share(ThinkingTokens)%; background: #4E6B60"></div>
                        </div>
                        <div class="ox-legend">
                            <span><i style="background: #FFFFFF"></i>Prompt @reply.PromptTokens.ToString("#,0")</span>
                            <span><i style="background: #8FD3B6"></i>Response @reply.CandidateTokens.ToString("#,0")</span>
                            <span><i style="background: #4E6B60"></i>Thinking @ThinkingTokens.ToString("#,0")</span>
                        </div>
                    </div>
                    @if (saved is not null)
                    {
                        <dl class="ox-mini-metrics">
                            <div><dt>Water</dt><dd>@saved.TotalWater.ToString("0.###")<small> mL</small></dd></div>
                            <div><dt>CO₂</dt><dd>@saved.TotalCo2.ToString("0.###")<small> g</small></dd></div>
                            <div><dt>Energy</dt><dd>@saved.TotalEnergy.ToString("0.###")<small> Wh</small></dd></div>
                        </dl>
                    }
                    @if (ThinkingTokens > reply.CandidateTokens)
                    {
                        <p class="ox-note mb-0">Most of this reply's tokens were Gemini's hidden "thinking", not the answer itself.</p>
                    }
                }
            </section>

            <section class="ox-panel d-flex flex-column gap-2">
                <h2 class="h5 m-0">How we estimate</h2>
                <p class="small mb-0" style="color: var(--ox-ink-2)">
                    Google's published figures for a median Gemini Apps text prompt (May 2025) are
                    @TokenImpactEstimator.ReferenceEnergyWh Wh, @TokenImpactEstimator.ReferenceCo2Grams g CO₂e and
                    @TokenImpactEstimator.ReferenceWaterMl mL water. We assume that prompt is
                    @TokenImpactEstimator.ReferenceTokenCount tokens and scale the energy by your token count.
                    Carbon and water follow from that energy with Google's method: CO₂e = energy × 94 g/kWh + embodied 0.010 g;
                    water = (energy − data-centre overhead, PUE 1.09) × 1.15 L/kWh.
                </p>
                <div class="ox-formula">energy = @TokenImpactEstimator.ReferenceEnergyWh Wh × tokens ÷ @TokenImpactEstimator.ReferenceTokenCount</div>
                <p class="ox-note mb-0">Every Gemini model gets the same factor. Rough estimates, not measurements. Source: Google, arXiv:2508.15734.</p>
            </section>

            <a class="ox-link-card" href="">
                <span>
                    <span class="d-block ox-note">Your totals</span>
                    <span class="fw-semibold">@TotalsText</span>
                </span>
                <Icon Name="chevron" Size="20" Color="#0E6B4F" Stroke="2.2" />
            </a>
        </aside>
    </div>
</div>

@code {
    private const string SavedText = "Saved to your usage history.";

    private string? userId;
    private string selectedModel = string.Empty;
    private string prompt = string.Empty;
    private string? lastPrompt;
    private bool sending;
    private string? error;
    private string? saveMessage;
    private GeminiReply? reply;
    private UsageRecord? saved;
    private IReadOnlyList<RecommendationEngine> recommendations = [];
    private UsageSummary? summary;

    private int ThinkingTokens => reply is null ? 0 : Math.Max(0, reply.TotalTokens - reply.PromptTokens - reply.CandidateTokens);

    private double Share(int tokens) => reply is null || reply.TotalTokens <= 0 ? 0 : tokens * 100.0 / reply.TotalTokens;

    private string TotalsText
    {
        get
        {
            if (summary is null || summary.TotalQueries == 0) return "Nothing recorded yet";
            var (water, co2, energy) = summary.Report.GetRunningTotals();
            return $"{summary.TotalQueries:#,0} queries · {water:0.#} mL · {co2:0.#} g · {energy:0.#} Wh";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        selectedModel = Gemini.Model;
        if (userId is not null)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        summary = await UsageTrackingService.GetSummaryAsync(userId!);
    }

    private async Task SendAsync()
    {
        if (userId is null || sending || string.IsNullOrWhiteSpace(prompt)) return;

        sending = true;
        error = null;
        saveMessage = null;
        reply = null;
        saved = null;
        recommendations = [];

        if (prompt.Length > Gemini.MaxPromptCharacters)
        {
            error = $"The prompt is too long. The limit is {Gemini.MaxPromptCharacters:N0} characters.";
            sending = false;
            return;
        }

        var allowance = Limiter.TryAcquire(userId);
        if (!allowance.Allowed)
        {
            error = allowance.Message;
            sending = false;
            return;
        }

        lastPrompt = prompt;
        try
        {
            reply = await Gemini.GenerateAsync(prompt, selectedModel);
            prompt = string.Empty;
        }
        catch (GeminiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            sending = false;
        }

        if (reply is null) return;

        try
        {
            var factor = TokenImpactEstimator.CreateFactor(reply.Model, reply.TotalTokens);
            var result = await UsageTrackingService.RecordAsync(userId, queryCount: 1, factor);
            saved = result.Record;
            recommendations = result.Recommendations;
            saveMessage = SavedText;
            await LoadAsync();
        }
        catch (ArgumentException ex)
        {
            saveMessage = $"The reply was received but could not be saved: {UserMessages.From(ex)}";
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            saveMessage = "The reply was received but could not be saved. Please check the database connection.";
        }
    }
}

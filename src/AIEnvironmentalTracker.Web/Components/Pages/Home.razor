@page "/"
@using System.Security.Claims
@using AIEnvironmentalTracker.Web.Data
@using AIEnvironmentalTracker.Web.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UsageTrackingService UsageTrackingService

<PageTitle>OxyGenAI Usage Tracker</PageTitle>

<h1>OxyGenAI Usage Tracker</h1>
<p>Record AI usage and estimate its environmental impact using factors you provide.</p>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">New usage record</h2>
        <p class="text-muted">Enter the impact per query for the model you used. These values are your estimates.</p>
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="model">AI model or application</label>
                    <input id="model" class="form-control" @bind="modelName" maxlength="120" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="queries">Number of queries</label>
                    <input id="queries" class="form-control" type="number" min="1" @bind="queryCount" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="water">Water per query (mL)</label>
                    <input id="water" class="form-control" type="number" min="0" step="any" @bind="waterPerQuery" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="co2">CO₂ per query (g)</label>
                    <input id="co2" class="form-control" type="number" min="0" step="any" @bind="co2PerQuery" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="energy">Energy per query (Wh)</label>
                    <input id="energy" class="form-control" type="number" min="0" step="any" @bind="energyPerQuery" required />
                </div>
            </div>
            <button class="btn btn-primary mt-3" type="submit" disabled="@saving">Save usage</button>
        </form>
        @if (!string.IsNullOrEmpty(message))
        {
            <p class="mt-3 mb-0" role="status">@message</p>
        }
    </div>
</div>

<h2 class="h5">Recent usage</h2>
@if (records.Count == 0)
{
    <p>No usage recorded yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Time (UTC)</th><th>Model</th><th>Queries</th><th>Water (mL)</th><th>CO₂ (g)</th><th>Energy (Wh)</th></tr></thead>
            <tbody>
                @foreach (var record in records)
                {
                    <tr>
                        <td>@record.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@record.AiModelName</td>
                        <td>@record.QueryCount</td>
                        <td>@record.TotalWater.ToString("0.######")</td>
                        <td>@record.TotalCo2.ToString("0.######")</td>
                        <td>@record.TotalEnergy.ToString("0.######")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string? userId;
    private string modelName = string.Empty;
    private int queryCount = 1;
    private decimal waterPerQuery;
    private decimal co2PerQuery;
    private decimal energyPerQuery;
    private bool saving;
    private string? message;
    private List<UsageRecord> records = [];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (userId is not null)
            records = await UsageTrackingService.GetRecentAsync(userId);
    }

    private async Task SaveAsync()
    {
        if (userId is null || saving) return;
        saving = true;
        message = null;
        try
        {
            await UsageTrackingService.RecordAsync(userId, modelName, queryCount,
                waterPerQuery, co2PerQuery, energyPerQuery);
            records = await UsageTrackingService.GetRecentAsync(userId);
            message = "Usage recorded in PostgreSQL.";
        }
        catch (ArgumentException ex)
        {
            message = ex.Message;
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            message = "Could not save the usage record. Please check the database connection.";
        }
        finally
        {
            saving = false;
        }
    }
}

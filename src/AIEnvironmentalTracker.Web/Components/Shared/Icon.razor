@* Small stroke icons used across the app. Decorative by default (aria-hidden). *@

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="@Color" stroke-width="@Stroke"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "water":
            <path d="M12 3c-3.5 4.5-6 7.6-6 10.5a6 6 0 0 0 12 0C18 10.6 15.5 7.5 12 3z"></path>
            break;
        case "co2":
            <path d="M7 18a4 4 0 0 1-.6-7.96A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9z"></path>
            break;
        case "energy":
            <path d="M13 2 4 14h7l-1 8 9-12h-7z"></path>
            break;
        case "queries":
            <path d="M4 6h16M4 12h10M4 18h6"></path>
            break;
        case "chat":
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            break;
        case "plus":
            <path d="M12 5v14M5 12h14"></path>
            break;
        case "arrow":
            <path d="M5 12h14M13 6l6 6-6 6"></path>
            break;
        case "chevron":
            <path d="M9 6l6 6-6 6"></path>
            break;
        case "check":
            <path d="m5 12 5 5L20 7"></path>
            break;
        case "spark":
            <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"></path>
            break;
        case "leaf":
            <path d="M5 19c8 0 14-6 14-14-8 0-14 6-14 14z"></path><path d="M5 19 13 11"></path>
            break;
        case "alert":
            <circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16.5v.01"></path>
            break;
        case "key":
            <circle cx="8" cy="15" r="4"></circle><path d="m10.8 12.2 8.2-8.2M16 7l2 2M14 9l2 2"></path>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string Color { get; set; } = "currentColor";
    [Parameter] public double Stroke { get; set; } = 2;
}

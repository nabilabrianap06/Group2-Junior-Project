@implements IDisposable

@inject NavigationManager NavigationManager

<header class="ox-topbar">
    <div class="ox-topbar-inner">
        <a class="ox-home" href="" aria-label="OxyGenAI home">
            <BrandMark />
        </a>

        <AuthorizeView>
            <Authorized>
                <nav class="ox-nav" aria-label="Main">
                    <NavLink class="ox-nav-link" href="" Match="NavLinkMatch.All">Usage tracker</NavLink>
                    <NavLink class="ox-nav-link" href="dashboard">Dashboard</NavLink>
                    <NavLink class="ox-nav-link" href="ask-gemini">Ask Gemini</NavLink>
                    <NavLink class="ox-nav-link" href="compare">Compare models</NavLink>
                    <AuthorizeView Roles="Admin" Context="adminContext">
                        <NavLink class="ox-nav-link" href="admin">Admin</NavLink>
                    </AuthorizeView>
                </nav>
                <div class="ox-account">
                    <NavLink class="ox-user" href="Account/Manage" title="Manage your account">
                        <span class="ox-avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</span>
                        <span class="ox-user-name">@context.User.Identity?.Name</span>
                    </NavLink>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="ox-logout">Log out</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="ox-account ox-account-guest">
                    <NavLink class="ox-nav-link" href="Account/Login">Log in</NavLink>
                    <NavLink class="ox-signup" href="Account/Register">Create account</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private static string Initial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : char.ToUpperInvariant(name.Trim()[0]).ToString();

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

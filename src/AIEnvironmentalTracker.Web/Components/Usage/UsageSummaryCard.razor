@* Totals for the signed-in user, read from a CarbonFootprintReport. *@

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Total queries</div>
            <div class="fs-4 fw-semibold">@(Summary?.TotalQueries ?? 0)</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Water</div>
            <div class="fs-4 fw-semibold">@Format(totals.Water) <span class="fs-6">mL</span></div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">CO₂</div>
            <div class="fs-4 fw-semibold">@Format(totals.CO2) <span class="fs-6">g</span></div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Energy</div>
            <div class="fs-4 fw-semibold">@Format(totals.Energy) <span class="fs-6">Wh</span></div>
        </div></div>
    </div>
</div>

@code {
    [Parameter] public UsageSummary? Summary { get; set; }

    private (decimal Water, decimal CO2, decimal Energy) totals;

    protected override void OnParametersSet()
        => totals = Summary?.Report.GetRunningTotals() ?? (0m, 0m, 0m);

    private static string Format(decimal value) => value.ToString("#,0.####");
}

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows shell: a WinForms window that hosts the Blazor app (started as a hidden process) in WebView2. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OxyGenAI-Desktop</AssemblyName>
    <RootNamespace>AIEnvironmentalTracker.Desktop</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- The WebView2 package also references its WPF assembly, which asks for a newer WindowsBase than this project
         uses. The shell only uses the WinForms control, so the harmless version-conflict warning is silenced. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

</Project>
